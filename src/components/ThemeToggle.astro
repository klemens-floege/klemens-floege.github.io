---
import Icon from './Icon.astro'
---

<button class="theme-toggle" type="button" aria-label="Switch colour theme" data-theme-toggle>
  <span class="theme-toggle__icon theme-toggle__icon--sun"><Icon name="sun" size="1.05rem" /></span>
  <span class="theme-toggle__icon theme-toggle__icon--moon"><Icon name="moon" size="1.05rem" /></span>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    color: var(--fg-muted);
    transition:
      color 0.15s var(--ease),
      background-color 0.15s var(--ease);
  }

  .theme-toggle:hover {
    color: var(--fg);
    background: var(--bg-sunk);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    display: grid;
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  /* Show the icon for the theme you would switch *to*. */
  :global(:root[data-theme='light']) .theme-toggle__icon--sun,
  :global(:root[data-theme='dark']) .theme-toggle__icon--moon {
    opacity: 0;
    transform: scale(0.6) rotate(-45deg);
  }

  :global(:root[data-theme='light']) .theme-toggle__icon--moon,
  :global(:root[data-theme='dark']) .theme-toggle__icon--sun {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  type Theme = 'light' | 'dark'

  const root = document.documentElement

  const currentTheme = (): Theme => (root.dataset['theme'] === 'dark' ? 'dark' : 'light')

  const apply = (theme: Theme): void => {
    root.dataset['theme'] = theme
    try {
      localStorage.setItem('theme', theme)
    } catch {
      // Private browsing or blocked storage — the toggle still works for this page.
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      apply(currentTheme() === 'dark' ? 'light' : 'dark')
    })
  }

  // Follow the OS only while the visitor has not made an explicit choice.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let stored: string | null = null
    try {
      stored = localStorage.getItem('theme')
    } catch {
      stored = null
    }
    if (stored !== 'light' && stored !== 'dark') {
      root.dataset['theme'] = event.matches ? 'dark' : 'light'
    }
  })
</script>
