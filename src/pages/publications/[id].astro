---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import { getCollection, render, type CollectionEntry } from 'astro:content'

import AuthorList from '~/components/AuthorList.astro'
import Icon from '~/components/Icon.astro'
import LinkBar from '~/components/LinkBar.astro'
import Base from '~/layouts/Base.astro'
import { formatMonthYear, isoDate } from '~/lib/format'

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('publications')
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

interface Props {
  entry: CollectionEntry<'publications'>
}

const { entry } = Astro.props
const { title, authors, date, venue, kind, abstract, summary, figure, figureCaption, tags, links } =
  entry.data
const { Content } = await render(entry)
---

<Base title={title} description={summary}>
  <article class="shell paper">
    <a class="back" href="/#publications">
      <Icon name="arrowLeft" size="0.9rem" />
      All publications
    </a>

    <header class="paper__head">
      <h1>{title}</h1>
      <AuthorList authors={authors} class="paper__authors" />
      <p class="paper__venue">
        {venue}
        <span class="paper__dot">·</span>
        <time datetime={isoDate(date)}>{formatMonthYear(date)}</time>
        <span class="tag">{kind}</span>
      </p>
      <LinkBar links={links} label={title} />
    </header>

    {
      figure && (
        <figure class="paper__figure">
          <Image src={figure} alt={figureCaption ?? `Figure from ${title}`} widths={[640, 960]} />
          {figureCaption && <figcaption>{figureCaption}</figcaption>}
        </figure>
      )
    }

    <section class="abstract">
      <h2>Abstract</h2>
      <p>{abstract}</p>
    </section>

    <div class="prose">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Topics">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </article>
</Base>

<style>
  .paper {
    padding-top: 2.5rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--fg-faint);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .paper__head {
    margin-top: 1.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .paper__head h1 {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .paper__authors {
    margin-top: 1rem;
    font-size: var(--step-0);
  }

  .paper__venue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--fg-faint);
  }

  .paper__dot {
    color: var(--rule-strong);
  }

  .paper__figure {
    margin-top: 2.5rem;
  }

  .paper__figure :global(img) {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--bg-sunk);
  }

  .paper__figure figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--fg-faint);
    line-height: 1.55;
  }

  .abstract {
    margin-top: 2.5rem;
  }

  .abstract h2 {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 0.75rem;
  }

  .abstract p {
    color: var(--fg-muted);
    border-left: 2px solid var(--rule-strong);
    padding-left: 1.25rem;
  }

  .prose {
    margin-top: 2.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
</style>
