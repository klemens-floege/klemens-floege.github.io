---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

import avatar from '~/assets/avatar.jpg'
import Icon from '~/components/Icon.astro'
import ProjectRow from '~/components/ProjectRow.astro'
import PublicationRow from '~/components/PublicationRow.astro'
import { certifications, education, experience } from '~/data/career'
import { profile } from '~/data/profile'
import Base from '~/layouts/Base.astro'
import { formatRange, formatYearMonth } from '~/lib/format'

const byNewest = <T extends { data: { date: Date } }>(a: T, b: T): number =>
  b.data.date.getTime() - a.data.date.getTime()

const publications = (await getCollection('publications')).sort(byNewest)
const projects = (await getCollection('projects')).sort(byNewest)
---

<Base isHome>
  <section class="hero shell">
    <div class="hero__text">
      <h1 class="hero__name">{profile.name}</h1>
      <p class="hero__role">
        {profile.role} at <a href={profile.org.href}>{profile.org.name}</a>
      </p>
      <p class="hero__location">{profile.location}</p>

      <ul class="socials">
        {
          profile.socials.map((social) => (
            <li>
              <a href={social.href} rel="noopener" aria-label={social.label} title={social.label}>
                <Icon name={social.icon} size="1.1rem" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <Image
      class="hero__avatar"
      src={avatar}
      alt={`Portrait of ${profile.name}`}
      width={280}
      densities={[1, 2]}
      loading="eager"
    />
  </section>

  <div class="shell">
    <section class="section" id="about">
      <h2 class="section__label">About</h2>
      <div class="about">
        <div class="about__bio">
          {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <aside class="about__aside">
          <div class="factlet">
            <h3>Focus</h3>
            <ul>
              {profile.interests.map((interest) => <li>{interest}</li>)}
            </ul>
          </div>
          <div class="factlet">
            <h3>Languages</h3>
            <ul>
              {profile.languages.map((language) => <li>{language}</li>)}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="section" id="publications">
      <h2 class="section__label">Publications</h2>
      {publications.map((entry) => <PublicationRow entry={entry} />)}
    </section>

    <section class="section" id="experience">
      <h2 class="section__label">Experience</h2>
      {
        experience.map((role) => (
          <article class="row">
            <div class="row__meta">{formatRange(role.start, role.end)}</div>
            <div>
              <h3 class="row__title">
                {role.title}
                <span class="at">at</span>
                {role.href ? <a href={role.href}>{role.org}</a> : role.org}
              </h3>
              <p class="row__sub">{role.location}</p>
              <p class="body">{role.description}</p>
            </div>
          </article>
        ))
      }
    </section>

    <section class="section" id="education">
      <h2 class="section__label">Education</h2>
      {
        education.map((degree) => (
          <article class="row">
            <div class="row__meta">{degree.year}</div>
            <div>
              <h3 class="row__title">
                {degree.qualification} <span class="at">in</span> {degree.field}
              </h3>
              <p class="row__sub">
                <a href={degree.href}>{degree.institution}</a>
              </p>
              {degree.note && <p class="body">{degree.note}</p>}
            </div>
          </article>
        ))
      }
    </section>

    <section class="section" id="projects">
      <h2 class="section__label">Projects &amp; Theses</h2>
      {projects.map((entry) => <ProjectRow entry={entry} />)}
    </section>

    <section class="section" id="certifications">
      <h2 class="section__label">Certifications</h2>
      {
        certifications.map((cert) => (
          <article class="row">
            <div class="row__meta">{formatYearMonth(cert.date)}</div>
            <div>
              <h3 class="row__title">{cert.title}</h3>
              <p class="row__sub">
                <a href={cert.organizationHref}>{cert.organization}</a>
              </p>
              {cert.certificateUrl && (
                <ul class="linkbar">
                  <li>
                    <a href={cert.certificateUrl} rel="noopener">
                      <Icon name="external" />
                      Certificate
                    </a>
                  </li>
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </section>

    <section class="section" id="contact">
      <h2 class="section__label">Contact</h2>
      <p class="contact__text">
        The fastest way to reach me is email — I read everything, and reply to most of it.
      </p>
      <a class="contact__email" href={`mailto:${profile.email}`}>
        <Icon name="mail" size="1rem" />
        {profile.email}
      </a>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    padding-top: clamp(3rem, 9vw, 5.5rem);
  }

  .hero__text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .hero__role {
    font-size: var(--step-1);
    color: var(--fg-muted);
    margin-top: 0.75rem;
  }

  .hero__role a {
    color: var(--fg);
    text-decoration-color: var(--accent);
  }

  .hero__role a:hover {
    color: var(--accent);
  }

  .hero__location {
    font-size: var(--step--1);
    color: var(--fg-faint);
    margin-top: 0.25rem;
  }

  .hero__avatar {
    flex: 0 0 auto;
    width: clamp(6rem, 20vw, 8.75rem);
    height: clamp(6rem, 20vw, 8.75rem);
    border-radius: 50%;
    object-fit: cover;
    /* Keeps the face centred when the 4:3 original is cropped to a circle. */
    object-position: 52% 38%;
    filter: saturate(0.92);
  }

  .socials {
    display: flex;
    gap: 0.375rem;
    margin-top: 1.5rem;
    margin-left: -0.5rem;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 999px;
    color: var(--fg-muted);
    transition:
      color 0.15s var(--ease),
      background-color 0.15s var(--ease);
  }

  .socials a:hover {
    color: var(--accent);
    background: var(--accent-quiet);
  }

  @media (max-width: 34rem) {
    .hero {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem;
    gap: 2.5rem;
    align-items: start;
  }

  .about__bio > * + * {
    margin-top: 1.1em;
  }

  .about__aside {
    display: grid;
    gap: 1.75rem;
    padding-top: 0.3rem;
  }

  .factlet h3 {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 0.5rem;
  }

  .factlet ul {
    display: grid;
    gap: 0.2rem;
    font-size: var(--step--1);
    color: var(--fg-muted);
    line-height: 1.5;
  }

  @media (max-width: 46rem) {
    .about {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about__aside {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }
  }

  .at {
    color: var(--fg-faint);
    font-weight: 400;
    font-style: italic;
  }

  .body {
    font-size: var(--step--1);
    color: var(--fg-muted);
    margin-top: 0.6rem;
    max-width: 42rem;
  }

  .contact__text {
    color: var(--fg-muted);
    max-width: 34rem;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 0.15rem;
  }

  .contact__email:hover {
    border-bottom-color: var(--accent);
  }
</style>
